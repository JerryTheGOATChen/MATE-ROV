<?xml version="1.0" ?>
<!--
  The ROV, a BlueROV2 Heavy-sized body that follows velocity commands, with the sensors the action
  module expects. xacro fills in the noise levels at launch. Gazebo has no DVL or depth sensor, so
  two noisy odometry publishers stand in for them, and the EKF fuses only the DVL one's velocity
  and the depth one's z. A third, noiseless one is the ground truth for scoring missions. The sonar
  is a GPU lidar shaped like a 3D imaging sonar's field of view.

  Keep colons out of comments in this file, because launch parses its output as YAML.
-->
<sdf version="1.9" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="dvl_stddev" default="0.0"/>
  <xacro:arg name="depth_stddev" default="0.0"/>
  <xacro:arg name="gyro_stddev" default="0.0"/>
  <xacro:arg name="sonar_stddev" default="0.0"/>

  <model name="rov">
    <link name="base_link">
      <inertial>
        <mass>11.5</mass>
        <inertia><ixx>0.379</ixx><iyy>0.262</iyy><izz>0.517</izz></inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.457 0.575 0.254</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.457 0.575 0.254</size></box></geometry>
        <material><ambient>0.1 0.15 0.35 1</ambient><diffuse>0.1 0.15 0.35 1</diffuse></material>
      </visual>

      <sensor name="imu" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <topic>/rov/imu</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>$(arg gyro_stddev)</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>$(arg gyro_stddev)</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>$(arg gyro_stddev)</stddev></noise></z>
          </angular_velocity>
        </imu>
      </sensor>

      <!-- Must match the base_link -> sonar_link transform in launch/gazebo.launch.yaml -->
      <sensor name="sonar" type="gpu_lidar">
        <pose>0.25 0 0 0 0 0</pose>
        <gz_frame_id>sonar_link</gz_frame_id>
        <topic>/rov/sonar</topic>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal><samples>64</samples><min_angle>-0.785</min_angle><max_angle>0.785</max_angle></horizontal>
            <vertical><samples>16</samples><min_angle>-0.349</min_angle><max_angle>0.349</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>10</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>$(arg sonar_stddev)</stddev></noise>
        </lidar>
      </sensor>
    </link>

    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/rov/cmd_vel</topic>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>10</odom_publish_frequency>
      <odom_topic>/model/rov/dvl_odometry</odom_topic>
      <odom_covariance_topic>/model/rov/dvl</odom_covariance_topic>
      <tf_topic>/model/rov/dvl_tf</tf_topic>
      <gaussian_noise>$(arg dvl_stddev)</gaussian_noise>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>/model/rov/depth_odometry</odom_topic>
      <odom_covariance_topic>/model/rov/depth</odom_covariance_topic>
      <tf_topic>/model/rov/depth_tf</tf_topic>
      <gaussian_noise>$(arg depth_stddev)</gaussian_noise>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_topic>/model/rov/ground_truth</odom_topic>
      <odom_covariance_topic>/model/rov/ground_truth_with_covariance</odom_covariance_topic>
      <tf_topic>/model/rov/ground_truth_tf</tf_topic>
    </plugin>
  </model>
</sdf>
