<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rov_gazebo_sim</name>
  <version>0.1.0</version>
  <description>Gazebo pool with a simulated ROV, its noisy sensors, an EKF and a 3D sonar, for testing the action module's Nav2</description>
  <maintainer email="hello@watonomous.ca">WATonomous</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>action_bringup</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>rov_mission_runner</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
