<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rov_kinematic_sim</name>
  <version>0.1.0</version>
  <description>Kinematic 4-DoF ROV simulator that stands in for the vehicle: follows cmd_vel, publishes odometry and TF</description>
  <maintainer email="hello@watonomous.ca">WATonomous</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>angles</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>action_bringup</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>wato_lifecycle_manager</exec_depend>

  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>rov_mission_runner</test_depend>
  <test_depend>tf2_msgs</test_depend>
  <test_depend>wato_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rclcpp_components/>
  </export>
</package>
