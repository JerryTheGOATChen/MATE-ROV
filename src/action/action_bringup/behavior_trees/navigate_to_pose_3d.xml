<!--
  Plan a 3D path, replanning once a second so the route avoids obstacles the sonar finds along the
  way, and follow it. There are no recovery behaviors: a navigation failure is reported to the
  caller, who decides whether to retry or hand control back to the pilot.
-->
<root BTCPP_format="4" main_tree_to_execute="NavigateToPose3D">
  <BehaviorTree ID="NavigateToPose3D">
    <PipelineSequence name="ReplanThenFollow">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="CostmapPlanner3D" error_code_id="{compute_path_error_code}"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker" progress_checker_id="progress_checker" error_code_id="{follow_path_error_code}"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
